rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Workspace keluarga diakses lewat PIN (familyId = PIN).
    // WAJIB login dengan akun Google — anonymous/credential lain ditolak.
    // Setiap anggota punya identitas akun Google-nya masing-masing di dalam workspace.
    match /families/{familyId} {
      allow read, write: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
  }
}
